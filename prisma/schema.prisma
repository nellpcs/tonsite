// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Boutique {
  id             String         @id @default(cuid())
  slug           String         @unique
  nom            String
  description    String?
  whatsapp       String
  email          String?
  categorie      String?
  ville          String?
  quartier       String?
  adresse        String?
  logoUrl        String?
  themePrimary   String         @default("#8C63FF")
  themeSecondary String         @default("#FF6584")
  themeAccent    String         @default("#00D084")
  statut         StatutBoutique @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vendeurs       Vendeur[]
  categories     Categorie[]
  produits       Produit[]
  clients        Client[]
  commandes      Commande[]
  visites        Visite[]
  abonnement     Abonnement?
}

model Vendeur {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  nom            String
  boutiqueId     String
  boutique       Boutique @relation(fields: [boutiqueId], references: [id])
  createdAt      DateTime @default(now())
}

model Categorie {
  id         String    @id @default(cuid())
  boutiqueId String
  boutique   Boutique  @relation(fields: [boutiqueId], references: [id])
  nom        String
  produits   Produit[]
}

model Produit {
  id             String          @id @default(cuid())
  boutiqueId     String
  boutique       Boutique        @relation(fields: [boutiqueId], references: [id])
  categorieId    String?
  categorie      Categorie?      @relation(fields: [categorieId], references: [id])
  nom            String
  description    String?
  prix           Int
  prixBarre      Int?
  enPromotion    Boolean         @default(false)
  stock          Int             @default(0)
  couleurs       String[]
  tailles        String[]
  images         String[]
  statut         StatutProduit   @default(EN_LIGNE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lignesCommande LigneCommande[]
  visites        Visite[]
}

model Client {
  id         String     @id @default(cuid())
  boutiqueId String
  boutique   Boutique   @relation(fields: [boutiqueId], references: [id])
  nom        String
  telephone  String
  ville      String?
  quartier   String?
  commandes  Commande[]
  createdAt  DateTime   @default(now())

  @@unique([boutiqueId, telephone])
}

model Commande {
  id            String          @id @default(cuid())
  numero        String          @unique
  boutiqueId    String
  boutique      Boutique        @relation(fields: [boutiqueId], references: [id])
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  statut        StatutCommande  @default(NOUVELLE)
  modeLivraison String?
  commentaire   String?
  sousTotal     Int
  livraison     Int             @default(0)
  total         Int
  lignes        LigneCommande[]
  paiement      Paiement?
  createdAt     DateTime        @default(now())
}

model LigneCommande {
  id           String   @id @default(cuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id])
  produitId    String
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Int
  taille       String?
  couleur      String?
}

model Paiement {
  id            String         @id @default(cuid())
  commandeId    String         @unique
  commande      Commande       @relation(fields: [commandeId], references: [id])
  montant       Int
  provider      String
  transactionId String?
  statut        StatutPaiement @default(EN_ATTENTE)
  createdAt     DateTime       @default(now())
}

model Visite {
  id          String   @id @default(cuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id])
  produitId   String?
  produit     Produit? @relation(fields: [produitId], references: [id])
  visiteurId  String
  createdAt   DateTime @default(now())

  @@index([boutiqueId, createdAt])
  @@index([boutiqueId, visiteurId, createdAt])
  @@index([produitId, createdAt])
}

model Abonnement {
  id         String    @id @default(cuid())
  boutiqueId String    @unique
  boutique   Boutique  @relation(fields: [boutiqueId], references: [id])
  plan       String    @default("gratuit")
  statut     String    @default("actif")
  dateDebut  DateTime  @default(now())
  dateFin    DateTime?
}

enum StatutBoutique {
  ACTIVE
  SUSPENDUE
}

enum StatutProduit {
  EN_LIGNE
  HORS_LIGNE
}

enum StatutCommande {
  NOUVELLE
  EN_COURS
  TERMINEE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
}
